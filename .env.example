# Docker Compose lee .env desde la raíz del proyecto. Copia solo si vas a personalizarlo.
# Para restringir el panel a esta máquina usa 127.0.0.1.
ROUDASH_BIND_ADDR=0.0.0.0
ROUDASH_PORT=8080
ROUDASH_API_OBFUSCATION=true
# Vacío: solo memoria. /data: permite guardar kubeconfigs en el volumen de Compose.
ROUDASH_PERSIST_DIR=
